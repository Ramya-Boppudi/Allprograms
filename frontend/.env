# ============================================================
# FRONTEND ENV  (Vite — variables must start with VITE_)
# Uncomment only the block you want to use.
# ============================================================

# ----- Local -----
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=http://localhost:8013
# VITE_FRONTEND_PORT=3010
# VITE_APP_BASE=/grievance/

# ----- Test server (git.edumatrixtech.com) -----
VITE_API_BASE_URL=http://git.edumatrixtech.com/grievance/api/
VITE_APP_BASE=/grievance/
VITE_FRONTEND_PORT=3010
VITE_PROXY_TARGET=http://localhost:8013

# ----- Other hosts (examples) -----
# VITE_API_BASE_URL=http://192.168.1.106/grievance/api/
# VITE_API_BASE_URL=http://erp.edumatrixgroup.com/grievance/api/
